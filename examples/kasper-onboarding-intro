<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Getting Started with Kasper — New Staff Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --k-purple: #534AB7;
    --k-purple-light: #EEEDFE;
    --k-purple-mid: #AFA9EC;
    --k-teal: #1D9E75;
    --k-teal-light: #E1F5EE;
    --k-teal-mid: #5DCAA5;
    --k-amber: #BA7517;
    --k-amber-light: #FAEEDA;
    --k-gray-light: #F4F3EF;
    --k-gray-mid: #B4B2A9;
    --k-gray-dark: #444441;
    --k-text: #1C1B18;
    --k-text-muted: #5F5E5A;
    --k-border: #D3D1C7;
    --k-white: #FFFFFF;
  }

  body {
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    color: var(--k-text);
    background: var(--k-white);
    line-height: 1.7;
    font-size: 16px;
  }

  .site-header {
    background: var(--k-purple);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  .header-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .header-brand {
    font-family: 'DM Serif Display', serif;
    font-size: 20px;
    color: #fff;
    letter-spacing: -0.3px;
  }
  .header-brand span { color: var(--k-teal-mid); }
  .header-label {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255,255,255,0.55);
    letter-spacing: 0.8px;
    text-transform: uppercase;
  }

  .hero {
    background: var(--k-purple-light);
    border-bottom: 1px solid var(--k-purple-mid);
    padding: 4rem 2rem 3rem;
  }
  .hero-inner { max-width: 720px; margin: 0 auto; }
  .hero-eyebrow {
    display: inline-block;
    background: var(--k-purple);
    color: #fff;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 1.25rem;
  }
  .hero h1 {
    font-family: 'DM Serif Display', serif;
    font-size: 42px;
    line-height: 1.2;
    color: var(--k-text);
    letter-spacing: -0.5px;
    margin-bottom: 1rem;
  }
  .hero h1 em { font-style: italic; color: var(--k-purple); }
  .hero-subtitle {
    font-size: 17px;
    color: var(--k-text-muted);
    max-width: 600px;
    line-height: 1.65;
    margin-bottom: 2rem;
  }
  .hero-meta { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .meta-chip { display: flex; align-items: center; gap: 6px; font-size: 13px; color: var(--k-gray-dark); }
  .meta-chip-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--k-teal); flex-shrink: 0; }

  .toc-bar {
    background: var(--k-gray-light);
    border-bottom: 1px solid var(--k-border);
    overflow-x: auto;
  }
  .toc-inner {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
  }
  .toc-link {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0.75rem 1rem;
    font-size: 13px;
    font-weight: 500;
    color: var(--k-text-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .toc-link:hover { color: var(--k-purple); border-bottom-color: var(--k-purple-mid); }
  .toc-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px; height: 18px;
    border-radius: 50%;
    background: var(--k-purple);
    color: #fff;
    font-size: 10px;
    font-weight: 500;
  }

  .page-body {
    max-width: 980px;
    margin: 0 auto;
    padding: 3rem 2rem 5rem;
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 3rem;
    align-items: start;
  }

  .sidebar { position: sticky; top: 80px; }
  .sidebar-card {
    background: var(--k-gray-light);
    border: 1px solid var(--k-border);
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1rem;
  }
  .sidebar-card h4 {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    color: var(--k-text-muted);
    margin-bottom: 0.75rem;
  }
  .tip-list { list-style: none; margin-top: 0.5rem; }
  .tip-list li {
    font-size: 13px;
    color: var(--k-text-muted);
    padding: 4px 0;
    display: flex;
    gap: 7px;
    align-items: flex-start;
    line-height: 1.5;
  }
  .tip-list li::before { content: '→'; color: var(--k-teal); font-size: 12px; flex-shrink: 0; margin-top: 2px; }
  .contact-row { display: flex; flex-direction: column; gap: 6px; }
  .contact-item { font-size: 13px; color: var(--k-text-muted); }
  .contact-item a { color: var(--k-purple); text-decoration: none; }

  .content-main { min-width: 0; }
  .section { margin-bottom: 3.5rem; scroll-margin-top: 90px; }
  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--k-border);
  }
  .section-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--k-purple);
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    flex-shrink: 0;
  }
  .section-header h2 {
    font-family: 'DM Serif Display', serif;
    font-size: 24px;
    letter-spacing: -0.3px;
    color: var(--k-text);
    font-weight: 400;
  }
  .section p { font-size: 15.5px; color: var(--k-text); margin-bottom: 1rem; line-height: 1.75; }
  .section p:last-child { margin-bottom: 0; }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    margin: 1.5rem 0;
  }
  .feature-card {
    background: var(--k-white);
    border: 1px solid var(--k-border);
    border-radius: 10px;
    padding: 1rem 1.1rem;
    transition: border-color 0.15s;
  }
  .feature-card:hover { border-color: var(--k-purple-mid); }
  .feature-card-icon {
    width: 34px; height: 34px;
    border-radius: 8px;
    background: var(--k-purple-light);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.6rem;
    font-size: 16px;
  }
  .feature-card h3 { font-size: 14px; font-weight: 500; color: var(--k-text); margin-bottom: 4px; }
  .feature-card p { font-size: 13px !important; color: var(--k-text-muted) !important; line-height: 1.55 !important; margin: 0 !important; }

  .step-list { margin: 1.5rem 0; }
  .step-item { display: flex; gap: 1rem; margin-bottom: 1.25rem; align-items: flex-start; }
  .step-bubble {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: var(--k-teal-light);
    border: 1.5px solid var(--k-teal-mid);
    color: var(--k-teal);
    font-size: 12px;
    font-weight: 500;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .step-content { flex: 1; min-width: 0; }
  .step-content strong { display: block; font-size: 14.5px; font-weight: 500; color: var(--k-text); margin-bottom: 3px; }
  .step-content span { font-size: 13.5px; color: var(--k-text-muted); line-height: 1.6; }

  .callout {
    border-radius: 10px;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .callout.purple { background: var(--k-purple-light); border: 1px solid var(--k-purple-mid); }
  .callout.teal { background: var(--k-teal-light); border: 1px solid var(--k-teal-mid); }
  .callout.amber { background: var(--k-amber-light); border: 1px solid #FAC775; }
  .callout-icon { font-size: 18px; flex-shrink: 0; margin-top: 1px; }
  .callout.purple .callout-icon { color: var(--k-purple); }
  .callout.teal .callout-icon { color: var(--k-teal); }
  .callout.amber .callout-icon { color: var(--k-amber); }
  .callout p { font-size: 14px !important; line-height: 1.65 !important; margin: 0 !important; color: var(--k-text) !important; }
  .callout p strong { font-weight: 500; }

  .journey-line {
    position: relative;
    margin: 1.5rem 0;
    padding-left: 2rem;
    border-left: 2px solid var(--k-border);
  }
  .journey-stop { position: relative; margin-bottom: 1.5rem; padding-left: 1rem; }
  .journey-stop::before {
    content: '';
    position: absolute;
    left: -2.35rem;
    top: 6px;
    width: 12px; height: 12px;
    border-radius: 50%;
    background: var(--k-purple);
    border: 2px solid var(--k-white);
    outline: 1.5px solid var(--k-purple-mid);
  }
  .journey-stop h3 { font-size: 14.5px; font-weight: 500; color: var(--k-text); margin-bottom: 3px; }
  .journey-stop p { font-size: 13.5px !important; color: var(--k-text-muted) !important; line-height: 1.6 !important; margin: 0 !important; }

  .faq-item { border-bottom: 1px solid var(--k-border); padding: 1rem 0; }
  .faq-q { font-size: 15px; font-weight: 500; color: var(--k-text); margin-bottom: 6px; }
  .faq-a { font-size: 14px; color: var(--k-text-muted); line-height: 1.7; }

  .data-table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 1.5rem 0; }
  .data-table th {
    text-align: left;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.7px;
    color: var(--k-text-muted);
    padding: 8px 12px;
    background: var(--k-gray-light);
    border-bottom: 1px solid var(--k-border);
  }
  .data-table td { padding: 10px 12px; border-bottom: 1px solid var(--k-border); color: var(--k-text); vertical-align: top; }
  .data-table tr:last-child td { border-bottom: none; }
  .data-table tr:hover td { background: var(--k-gray-light); }
  .badge { display: inline-block; padding: 2px 8px; border-radius: 20px; font-size: 11.5px; font-weight: 500; }
  .badge-purple { background: var(--k-purple-light); color: var(--k-purple); }
  .badge-teal { background: var(--k-teal-light); color: #0F6E56; }
  .badge-amber { background: var(--k-amber-light); color: var(--k-amber); }
  .only-tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 500;
    background: var(--k-purple);
    color: #fff;
    padding: 1px 6px;
    border-radius: 4px;
    margin-left: 5px;
    vertical-align: middle;
    letter-spacing: 0.3px;
  }

  .site-footer { background: var(--k-text); padding: 2rem; text-align: center; }
  .footer-inner { max-width: 980px; margin: 0 auto; }
  .footer-inner p { font-size: 13px; color: rgba(255,255,255,0.45); margin-bottom: 4px; }
  .footer-inner a { color: rgba(255,255,255,0.65); text-decoration: none; }

  @media (max-width: 760px) {
    .page-body { grid-template-columns: 1fr; }
    .sidebar { position: static; }
    .hero h1 { font-size: 30px; }
  }
</style>
</head>
